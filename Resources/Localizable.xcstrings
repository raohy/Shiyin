    "建议加入：从参加者、说话者名字、校正过的字、会议标题找到的": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggested terms, from participants, speaker names, corrected words and meeting titles"
